]
STAGE_B_MECHANISM_MANIFESTS = [
    f"{RUN_ROOT}/{CAMPAIGN}/stage_b/{system}/r{replica}/candidates/manifest.json"
    for system, replica, _state in STAGE_B_MECHANISM_JOBS
]
STAGE_B_MECHANISM_STATE_IDS = [state for _system, _replica, state in STAGE_B_MECHANISM_JOBS]
STAGE_B_MECHANISM_TARGET_VALUES = [
    STAGE_B_MECHANISM_TARGETS[state] for state in STAGE_B_MECHANISM_STATE_IDS
]
STAGE_B_LOCALIZATION_STATE_RECORDS = [
