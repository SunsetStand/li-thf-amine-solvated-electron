import json
import shlex
import sys
from pathlib import Path

configfile: "configs/campaign.yaml"

CAMPAIGN = config.get("campaign", "pilot")
if CAMPAIGN not in config["campaigns"]:
    raise ValueError(f"Unknown campaign {CAMPAIGN!r}")

DEFINITION = config["campaigns"][CAMPAIGN]
SYSTEMS = DEFINITION["systems"]
REPLICAS = DEFINITION.get("replicas", config.get("replicas", [1]))
PAIRS = [(system, int(replica)) for system in SYSTEMS for replica in REPLICAS]
ROOT = Path(workflow.basedir).parent.resolve()
RUN_ROOT_PATH = Path(str(config.get("run_root", "runs")))
if not RUN_ROOT_PATH.is_absolute():
    RUN_ROOT_PATH = ROOT / RUN_ROOT_PATH
RUN_ROOT = RUN_ROOT_PATH.resolve().as_posix()
STORAGE_ROOT_PATH = Path(str(config.get("storage_root", RUN_ROOT_PATH.parent)))
if not STORAGE_ROOT_PATH.is_absolute():
    STORAGE_ROOT_PATH = ROOT / STORAGE_ROOT_PATH
STORAGE_ROOT = STORAGE_ROOT_PATH.resolve().as_posix()
SHARED_ROOT = f"{RUN_ROOT}/_shared"
SYSTEM_CATALOG = json.loads((ROOT / "configs" / "systems.yaml").read_text(encoding="utf-8"))
METHOD_CATALOG = json.loads((ROOT / "configs" / "methods.yaml").read_text(encoding="utf-8"))
SOLVELEC_SOURCES = sorted(str(path) for path in Path("src/solvelec").glob("*.py"))
PYTHON = shlex.quote(sys.executable)
STAGE_RUNNER = (ROOT / "workflow" / "scripts" / "run_tmc_stage.sh").as_posix()
PREPARE_MOLECULE = (ROOT / "workflow" / "scripts" / "prepare_molecule.py").as_posix()
BUILD_GROMACS = (ROOT / "workflow" / "scripts" / "build_gromacs_system.py").as_posix()
RUN_GROMACS = (ROOT / "workflow" / "scripts" / "run_gromacs_stage.py").as_posix()
VALIDATE_CLASSICAL = (
    ROOT / "workflow" / "scripts" / "validate_classical_pilot.py"
).as_posix()
ANALYZE_CLASSICAL = (
    ROOT / "workflow" / "scripts" / "analyze_classical_ensemble.py"
).as_posix()
PREPARE_STAGE_B = (ROOT / "workflow" / "scripts" / "prepare_stage_b.py").as_posix()
ENGINE_RUNNER = (ROOT / "workflow" / "scripts" / "run_checked_engine.py").as_posix()
AMBER_PYTHON = f"{STORAGE_ROOT}/software/conda/envs/ambertools/bin/python"
STAGE_RUNTIME_INPUTS = [
    STAGE_RUNNER,
    "configs/slurm/tmc-amd-stage-modules.sh",
    "configs/slurm/tmc-amd-storage.sh",
]


def pair_outputs(pattern):
    return [pattern.format(campaign=CAMPAIGN, system=system, replica=replica) for system, replica in PAIRS]


SPEC_OUTPUTS = pair_outputs(f"{RUN_ROOT}/{{campaign}}/specs/{{system}}/r{{replica}}.json")
PACKMOL_OUTPUTS = pair_outputs(
    f"{RUN_ROOT}/{{campaign}}/inputs/{{system}}/r{{replica}}/packmol.inp"
)
CP2K_OUTPUTS = pair_outputs(
    f"{RUN_ROOT}/{{campaign}}/inputs/{{system}}/r{{replica}}/cp2k_cdft.inp"
)
CLASSICAL_SMOKE_OUTPUTS = pair_outputs(
    f"{RUN_ROOT}/{{campaign}}/classical/{{system}}/r{{replica}}/npt/npt.gro"
)
CLASSICAL_SMOKE_VALIDATIONS = pair_outputs(
    f"{RUN_ROOT}/{{campaign}}/classical/{{system}}/r{{replica}}/npt/validation.json"
)
CLASSICAL_PILOT_VALIDATIONS = pair_outputs(
    f"{RUN_ROOT}/{{campaign}}/classical/{{system}}/r{{replica}}/pilot/validation.json"
)
CLASSICAL_ANALYSIS_RECORDS = pair_outputs(
    f"{RUN_ROOT}/{{campaign}}/analysis/{{system}}/r{{replica}}/analysis.json"
)
SNAPSHOT_RECORDS = pair_outputs(
    f"{RUN_ROOT}/{{campaign}}/analysis/{{system}}/r{{replica}}/snapshot/metadata.json"
)
STAGE_B_MANIFESTS = pair_outputs(
    f"{RUN_ROOT}/{{campaign}}/stage_b/{{system}}/r{{replica}}/candidates/manifest.json"
)
STAGE_B_CANDIDATE_IDS = [
    str(record["id"]) for record in METHOD_CATALOG["stage_b"]["candidate_pairs"]
]
STAGE_B_SMOKE_CANDIDATE = str(METHOD_CATALOG["stage_b"]["smoke_candidate_id"])
STAGE_B_SMOKE_REPLICAS = int(METHOD_CATALOG["stage_b"]["smoke_replicas_per_system"])
STAGE_B_SMOKE_PAIRS = [
    (system, replica)
    for system in SYSTEMS
    for replica in sorted(int(value) for value in REPLICAS)[:STAGE_B_SMOKE_REPLICAS]
]
STAGE_B_SMOKE_OUTPUTS = [
    (
        f"{RUN_ROOT}/{CAMPAIGN}/stage_b/{system}/r{replica}/smoke/"
        f"{STAGE_B_SMOKE_CANDIDATE}/cp2k.out"
    )
    for system, replica in STAGE_B_SMOKE_PAIRS
]
STAGE_B_SMOKE_INPUTS = [path.replace("cp2k.out", "cp2k.inp") for path in STAGE_B_SMOKE_OUTPUTS]
STAGE_B_SMOKE_MANIFESTS = [
    f"{RUN_ROOT}/{CAMPAIGN}/stage_b/{system}/r{replica}/candidates/manifest.json"
    for system, replica in STAGE_B_SMOKE_PAIRS
]


def amine_for_system(system):
    if system == "pure_thf":
        return None
    return system.rsplit("_", 1)[0]


def molecule_record(molecule):
    if molecule == "thf":
        return SYSTEM_CATALOG["thf"]
    return SYSTEM_CATALOG["amines"][molecule]


def molecule_path(molecule, suffix):
    return f"{SHARED_ROOT}/molecules/{molecule}/{molecule}.{suffix}"


def molecules_for_system(system):
    molecules = ["thf"]
    amine = amine_for_system(system)
    if amine:
        molecules.append(amine)
    return molecules


def molecule_pdb_inputs(wildcards):
    return [molecule_path(name, "pdb") for name in molecules_for_system(wildcards.system)]


def molecule_parameter_inputs(wildcards):
    paths = []
    for name in molecules_for_system(wildcards.system):
        paths.extend([molecule_path(name, "mol2"), molecule_path(name, "frcmod")])
    return paths


def packmol_amine_argument(wildcards):
    amine = amine_for_system(wildcards.system)
    if not amine:
        return ""
    return f"--amine-structure {shlex.quote(molecule_path(amine, 'pdb'))}"


def tleap_molecule_arguments(wildcards):
    arguments = []
    for name in molecules_for_system(wildcards.system):
        record = molecule_record(name)
        count = config["thf_count"] if name == "thf" else None
        if count is None:
            # The build script verifies this count against the generated topology;
            # the value is calculated by the same config model used for the spec.
            from solvelec.config import make_system_spec

            spec = make_system_spec(wildcards.system, config, SYSTEM_CATALOG)
            count = spec.amine_count_initial
        values = [
            record["residue"],
            molecule_path(name, "mol2"),
            molecule_path(name, "frcmod"),
            str(count),
        ]
        arguments.append("--molecule " + " ".join(shlex.quote(value) for value in values))
    return " ".join(arguments)


def pilot_previous_coordinates(wildcards):
    previous = {"nvt": "em", "npt": "nvt", "production": "npt"}[wildcards.stage]
    return (
        f"{RUN_ROOT}/{CAMPAIGN}/classical/{wildcards.system}/r{wildcards.replica}/"
        f"pilot/{previous}/{previous}.gro"
    )


def pilot_previous_checkpoint(wildcards):
    previous = {"npt": "nvt", "production": "npt"}.get(wildcards.stage)
    if previous is None:
        return []
    return (
        f"{RUN_ROOT}/{CAMPAIGN}/classical/{wildcards.system}/r{wildcards.replica}/"
        f"pilot/{previous}/{previous}.cpt"
    )


def pilot_previous_validation(wildcards):
    previous = {"nvt": "em", "npt": "nvt", "production": "npt"}[wildcards.stage]
    return (
        f"{RUN_ROOT}/{CAMPAIGN}/classical/{wildcards.system}/r{wildcards.replica}/"
        f"pilot/{previous}/engine.validation.json"
    )


def pilot_checkpoint_argument(wildcards):
    checkpoint_path = pilot_previous_checkpoint(wildcards)
    return "" if not checkpoint_path else f"--checkpoint {shlex.quote(checkpoint_path)}"


def require_pilot_campaign(_wildcards):
    if CAMPAIGN != "pilot":
        raise ValueError(
            f"classical_pilot is restricted to campaign 'pilot', not {CAMPAIGN!r}"
        )
    return CAMPAIGN


rule all:
    input:
        f"{RUN_ROOT}/{CAMPAIGN}/input_bundle.done"


