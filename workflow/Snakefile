PREPARE_STAGE_B = (ROOT / "workflow" / "scripts" / "prepare_stage_b.py").as_posix()
ANALYZE_STAGE_B_LOCALIZATION = (
    ROOT / "workflow" / "scripts" / "analyze_stage_b_localization.py"
