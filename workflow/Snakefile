    for record in STAGE_B_MECHANISM_STATES
}
STAGE_B_MECHANISM_JOBS = [
    (system, replica, str(state["id"]))
    for system, replica in STAGE_B_SMOKE_PAIRS
    for state in STAGE_B_MECHANISM_STATES
]
STAGE_B_MECHANISM_OUTPUTS = [
