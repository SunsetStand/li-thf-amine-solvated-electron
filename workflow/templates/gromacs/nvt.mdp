integrator              = md
dt                      = 0.002
nsteps                  = 250000
continuation            = no
constraint-algorithm    = lincs
constraints             = h-bonds
cutoff-scheme           = Verlet
coulombtype             = PME
rcoulomb                = 1.2
vdwtype                 = Cut-off
rvdw                    = 1.2
tcoupl                  = v-rescale
tc-grps                 = System
tau-t                   = 1.0
ref-t                   = 298.15
pcoupl                  = no
gen-vel                 = yes
gen-temp                = 298.15
gen-seed                = -1
nstxout-compressed      = 5000
nstenergy               = 1000
nstlog                  = 1000
pbc                     = xyz
