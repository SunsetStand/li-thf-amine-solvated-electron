integrator              = md
dt                      = 0.002
nsteps                  = 2500000
continuation            = yes
constraint-algorithm    = lincs
constraints             = h-bonds
cutoff-scheme           = Verlet
coulombtype             = PME
rcoulomb                = 1.2
vdwtype                 = Cut-off
rvdw                    = 1.2
tcoupl                  = v-rescale
tc-grps                 = System
tau-t                   = 1.0
ref-t                   = 298.15
pcoupl                  = c-rescale
pcoupltype              = isotropic
tau-p                   = 5.0
ref-p                   = 1.0
compressibility         = 8.0e-5
gen-vel                 = no
nstxout-compressed      = 5000
nstenergy               = 1000
nstlog                  = 1000
pbc                     = xyz
